# Backend (FastAPI). Copy to backend/.env.
YOUCAM_API_KEY=replace_with_your_youcam_api_key
# YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
# MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173

# Legacy community endpoints only (/api/community/*). SERVER-SIDE ONLY: this key bypasses RLS, so it must never go in frontend/.
# The new Living Wall, auth, dashboard and similarity score talk to Supabase from the browser with the anon key and do not need it.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
